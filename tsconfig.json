{
  "compilerOptions": {
    "allowJs": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@aistclaw/api/*": [
        "./src/api/aistclaw/*"
      ],
      "@aistclaw/components/*": [
        "./src/components/aistclaw/*"
      ],
      "@aistclaw/constants/*": [
        "./src/constants/aistclaw/*"
      ],
      "@aistclaw/hooks/*": [
        "./src/hooks/aistclaw/*"
      ],
      "@aistclaw/i18n": [
        "./src/i18n/aistclaw/index.ts"
      ],
      "@aistclaw/i18n/*": [
        "./src/i18n/aistclaw/*"
      ],
      "@aistclaw/lib/*": [
        "./src/lib/aistclaw/*"
      ],
      "@aistclaw/pages/*": [
        "./src/pages/aistclaw/*"
      ],
      "@aistclaw/routes": [
        "./src/aistclaw-routes.tsx"
      ],
      "@aistclaw/stores/*": [
        "./src/stores/aistclaw/*"
      ],
      "@aistclaw/types/*": [
        "./src/types/aistclaw/*"
      ]
    },
    "skipLibCheck": true,
    "strictNullChecks": false
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}