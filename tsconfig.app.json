{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@aistclaw/api/*": [
        "./src/api/aistclaw/*"
      ],
      "@aistclaw/components/*": [
        "./src/components/aistclaw/*"
      ],
      "@aistclaw/constants/*": [
        "./src/constants/aistclaw/*"
      ],
      "@aistclaw/hooks/*": [
        "./src/hooks/aistclaw/*"
      ],
      "@aistclaw/i18n": [
        "./src/i18n/aistclaw/index.ts"
      ],
      "@aistclaw/i18n/*": [
        "./src/i18n/aistclaw/*"
      ],
      "@aistclaw/lib/*": [
        "./src/lib/aistclaw/*"
      ],
      "@aistclaw/pages/*": [
        "./src/pages/aistclaw/*"
      ],
      "@aistclaw/routes": [
        "./src/aistclaw-routes.tsx"
      ],
      "@aistclaw/stores/*": [
        "./src/stores/aistclaw/*"
      ],
      "@aistclaw/types/*": [
        "./src/types/aistclaw/*"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "chat"
  ]
}