{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@goclaw/api/*": [
        "./src/api/goclaw/*"
      ],
      "@goclaw/components/*": [
        "./src/components/goclaw/*"
      ],
      "@goclaw/constants/*": [
        "./src/constants/goclaw/*"
      ],
      "@goclaw/hooks/*": [
        "./src/hooks/goclaw/*"
      ],
      "@goclaw/i18n": [
        "./src/i18n/goclaw/index.ts"
      ],
      "@goclaw/i18n/*": [
        "./src/i18n/goclaw/*"
      ],
      "@goclaw/lib/*": [
        "./src/lib/goclaw/*"
      ],
      "@goclaw/pages/*": [
        "./src/pages/goclaw/*"
      ],
      "@goclaw/routes": [
        "./src/goclaw/routes.tsx"
      ],
      "@goclaw/stores/*": [
        "./src/stores/goclaw/*"
      ],
      "@goclaw/types/*": [
        "./src/types/goclaw/*"
      ],
      "@goclaw/*": [
        "./src/goclaw/*"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "chat"
  ]
}